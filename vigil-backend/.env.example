# Groq API key for the narration endpoint. Without it the API returns a
# deterministic fallback note instead of LLM narration.
GROQ_API_KEY=your-groq-api-key-here

# Groq model used for narration. Override with a model available to your key.
GROQ_MODEL=openai/gpt-oss-120b

# Maximum fresh Groq narration requests per visitor IP and UTC day.
MAX_LIVE_NARRATIONS_PER_IP_PER_DAY=6

# Maximum fresh Groq narration requests across all visitors and UTC day.
MAX_LIVE_NARRATIONS_PER_DAY=50

# Comma-separated list of browser origins allowed to call this API.
# Defaults to the local dev origins (http://localhost:3000, http://127.0.0.1:3000).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
